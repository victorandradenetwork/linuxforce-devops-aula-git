FROM debian:12-slim

LABEL maintainer="Victor Andrade"
ENV PORT=80

RUN apt update && apt install apache2 php libapache2-mod-php php-mysql vim -y && a2enmod php8.2

# Remova o arquivo index.html padrão
RUN rm -f /var/www/html/index.html

COPY ./web/ /var/www/html

EXPOSE $PORT

WORKDIR /etc/apache2

CMD ["apachectl", "-D", "FOREGROUND"]

